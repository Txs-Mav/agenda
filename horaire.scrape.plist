<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ca.qc.cegeptr.agenda.scrape</string>

  <!-- Chemins absolus : launchd ne charge pas ton .zshrc, donc npm ne serait
       pas sur le PATH d'un shell de connexion non interactif. -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/npm</string>
    <string>run</string>
    <string>scrape</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/maverickmenard/Desktop/agenda</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <!-- Toutes les heures. launchd rattrape au réveil si le Mac dormait. -->
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/maverickmenard/Desktop/agenda/data/scrape.log</string>
  <key>StandardErrorPath</key><string>/Users/maverickmenard/Desktop/agenda/data/scrape.log</string>
</dict>
</plist>
