# Copie ce fichier vers .env et remplis-le. .env n'est jamais commité.
# Sur Railway, définis ces mêmes clés dans les Variables du service.
#
# Les valeurs ci-dessous sont des SENTINELLES: le code REFUSE de les soumettre
# à Omnivox. Tant qu'elles sont là, `npm run check` s'arrête au lieu de tenter
# une connexion — parce qu'un login raté arme le captcha et verrouille le DA.

OMNIVOX_USER=REMPLACE_MOI
OMNIVOX_PASS=REMPLACE_MOI

OMNIVOX_HOST=cegeptr.omnivox.ca

# Local: ./data — Railway: le point de montage du volume, ex. /data
DATA_DIR=./data
