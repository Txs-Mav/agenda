# Copie ce fichier vers .env et remplis-le. .env n'est jamais commité.
# Sur Railway, définis ces mêmes clés dans les Variables du service.
#
# Les valeurs ci-dessous sont des SENTINELLES: le code REFUSE de les soumettre
# à Omnivox. Tant qu'elles sont là, `npm run check` s'arrête au lieu de tenter
# une connexion — parce qu'un login raté arme le captcha et verrouille le DA.

OMNIVOX_USER=REMPLACE_MOI
OMNIVOX_PASS=REMPLACE_MOI

OMNIVOX_HOST=cegeptr.omnivox.ca

# Résumés des MIO (facultatif). Sans clé, l'aperçu de la liste tient lieu de résumé.
# Modèle utilisé : claude-haiku-4-5, le moins cher.
ANTHROPIC_API_KEY=

# Synchronisation nuagique (facultatif). Compte d'AGENDA (courriel + mot de
# passe créés dans l'app) — PAS tes identifiants Omnivox, qui restent locaux.
AGENDA_EMAIL=
AGENDA_PASSWORD=

# Moodle (facultatif). Le COMPTE LOCAL Moodle si tu en as un — sinon laisse
# vide : `npm run moodle-login` passera par le SSO M365 dans un navigateur
# visible, une seule fois, et le jeton durable vit dans data/ (gitignoré).
MOODLE_HOST=cegeptr.moodle.decclic.qc.ca
MOODLE_USER=
MOODLE_PASS=

# Local: ./data — Railway: le point de montage du volume, ex. /data
DATA_DIR=./data

# Notifications push (facultatif). Génère une paire avec :
#   npx web-push generate-vapid-keys
# La clé PUBLIQUE vit dans public/config.js, avec le reste de la config
# d'instance (elle est publique par conception) ; la PRIVÉE ne vit qu'ici.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:toi@exemple.com
