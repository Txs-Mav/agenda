# Copie ce fichier vers .env et remplis-le. .env n'est jamais commité.
# Sur Railway, définis ces mêmes clés dans les Variables du service.

# Identifiants Omnivox — cegeptr.omnivox.ca
OMNIVOX_USER=1234567
OMNIVOX_PASS=motdepasse-bidon-remplace-moi

# Sous-domaine Omnivox du cégep (sans https://)
OMNIVOX_HOST=cegeptr.omnivox.ca

# Où vivent l'état et les artefacts de run.
# Local: ./data — Railway: le point de montage du volume, ex. /data
DATA_DIR=./data

# true = navigateur visible (pour le premier login manuel)
HEADED=false
